        <mxCell id="QhdfSLl6MQ5XtQjQgA5W-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=8;" value="Push notification (async) or sms/email" vertex="1">
          <mxGeometry height="20" width="170" x="130" y="357" as="geometry" />
        </mxCell>
        <mxCell id="QhdfSLl6MQ5XtQjQgA5W-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=9;" value="Done" vertex="1">
          <mxGeometry height="10" width="30" x="294" y="328" as="geometry" />
        </mxCell>
        <mxCell id="QhdfSLl6MQ5XtQjQgA5W-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=8;fontFamily=Helvetica;labelPosition=center;verticalLabelPosition=middle;spacing=2;" value="&lt;div&gt;Step 1: {payload, signature} = &lt;b&gt;&lt;i&gt;decrypt&lt;/i&gt;&lt;/b&gt;(cipher, BE PriKey)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 2: Check expiry using timeStamp1.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - If Expired: return &lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;Declined&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 3: &lt;b&gt;&lt;i&gt;verify&lt;/i&gt;&lt;/b&gt;(signature, payer PubKey)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Invalid Signature: return &lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;Declined&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 4: Check&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;&lt;i&gt;&lt;font style=&quot;font-size: 6.5px;&quot;&gt;orderAmount &amp;lt;= maxAmount and&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;orderAmount &amp;lt;= walletBalance&lt;/span&gt;&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - False: return &lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;Declined&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 5: Check randToken alredy used (cache table)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Found: match original transaction&#39;s idempotency key&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Matches (Genuine retry) : return stored result&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Not match (replay/fraud): return &lt;span style=&quot;color: rgb(204, 0, 0);&quot;&gt;Declined&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 6: Find payerID and Check idempotency&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;font style=&quot;font-size: 6.5px;&quot; face=&quot;Helvetica&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;i style=&quot;&quot;&gt;(terminalId + receiptNumber + payerId + businessDate + orderAmount)&lt;/i&gt;&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Match found: return stored result&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Step 7: Process as one atomic operation:&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Calculate vat amount&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Write ledger entries (debit payer, credit merchant)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Update Transaction/Wallet Tables&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Mark randToken as consumed&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - Store result keyed by composite key&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; - return &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;Success&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="279.64" width="244" x="578" y="113.18" as="geometry" />
        </mxCell>
